{
  "name": "vorce-electron-agent",
  "version": "1.0.0",
  "description": "VORCE desktop monitoring agent. Authenticates with Firebase, exposes a local monitoring API, and writes desktop device/metrics data to Firestore.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "rebuild": "electron-rebuild",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "VORCE",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hellyoshaqiqie17/vorce-electron.git"
  },
  "build": {
    "appId": "com.vorce.agent",
    "productName": "VORCE Agent",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "vorcelogo/vorce.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "vorcelogo/vorce.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "vorcelogo/vorce.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": {
      "name": "VORCE Agent",
      "schemes": [
        "vorce-agent"
      ]
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      "vorcelogo/**"
    ]
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "node-machine-id": "^1.1.12",
    "pidusage": "^4.0.1",
    "systeminformation": "^5.22.11"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "desktop-idle": "^1.3.0"
  }
}
