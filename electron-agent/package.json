{
  "name": "vorce-electron-agent",
  "version": "1.0.0",
  "description": "VORCE desktop monitoring agent. Authenticates with Firebase, exposes a local monitoring API, and writes desktop device/metrics data to Firestore.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "rebuild": "electron-rebuild"
  },
  "author": "VORCE",
  "license": "UNLICENSED",
  "dependencies": {
    "active-win": "^8.2.1",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "node-machine-id": "^1.1.12",
    "pidusage": "^4.0.1",
    "systeminformation": "^5.22.11"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-rebuild": "^3.2.9"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "desktop-idle": "^1.3.0"
  }
}
