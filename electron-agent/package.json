{
  "name": "vlinked-electron-agent",
  "version": "1.0.0",
  "description": "Vlinked desktop monitoring agent. Authenticates with Firebase, exposes a local monitoring API, and writes desktop device/metrics data to Firestore.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "rebuild": "electron-rebuild",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "Vlinked",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hellyoshaqiqie17/vorce-electron.git"
  },
  "build": {
    "appId": "com.vlinked.vlinked",
    "productName": "Vlinked",
    "publish": {
      "provider": "github",
      "owner": "hellyoshaqiqie17",
      "repo": "vorce-electron"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "vorcelogo/VLinked.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "vorcelogo/VLinked.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": {
        "teamId": "TK5W5C4S89"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "vorcelogo/VLinked.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": {
      "name": "Vlinked",
      "schemes": [
        "vlinked"
      ]
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      "vorcelogo/**"
    ]
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "node-machine-id": "^1.1.12",
    "pidusage": "^4.0.1",
    "systeminformation": "^5.22.11"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "desktop-idle": "^1.3.0"
  }
}
