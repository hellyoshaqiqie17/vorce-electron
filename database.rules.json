{
  "rules": {
    "companies": {
      "$companyId": {
        "online_users": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$userId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "typing_status": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$userId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        }
      }
    },
    "status": {
      "$companyId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$deviceId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "stats": {
      "$companyId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$summaryId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('companyId').val() == $companyId && $summaryId.contains(newData.child('deviceId').val())"
        }
      }
    }
  }
}
